---
import Layout from "../layouts/Layout.astro";
import LegalDocument from "../components/LegalDocument.astro";

const sections = [
  { title: "Postanowienia ogólne", paragraphs: ["Niniejsze warunki określają zasady korzystania z aplikacji Paczkowo oraz strony paczkowo.net.", "Usługodawcą jest podmiot prowadzący markę Paczkowo. Dane identyfikacyjne usługodawcy, adres oraz NIP należy uzupełnić przed udostępnieniem usługi komercyjnie."] },
  { title: "Konto i dostęp", paragraphs: ["Użytkownik jest zobowiązany korzystać z aplikacji zgodnie z prawem, warunkami dostawców integracji oraz niniejszymi warunkami.", "Użytkownik odpowiada za zabezpieczenie swojego urządzenia, danych logowania i uprawnień do podłączonych kont sprzedażowych."] },
  { title: "Integracje zewnętrzne", paragraphs: ["Paczkowo umożliwia połączenie z usługami zewnętrznymi, takimi jak Allegro, Erli i InPost. Dostęp oraz zakres danych zależą od uprawnień nadanych przez użytkownika.", "Dostawcy usług zewnętrznych mogą wprowadzać własne ograniczenia, przerwy techniczne lub zmiany w API."] },
  { title: "Odpowiedzialność", paragraphs: ["Użytkownik przed wykonaniem operacji wysyłkowej, magazynowej lub sprzedażowej powinien zweryfikować dane widoczne w aplikacji.", "Usługodawca podejmuje uzasadnione działania dla ciągłości działania aplikacji, jednak nie gwarantuje braku przerw wynikających z działania dostawców zewnętrznych lub infrastruktury użytkownika."] },
  { title: "Kontakt i zmiany", paragraphs: ["Pytania dotyczące korzystania z aplikacji można kierować na adres kontakt@paczkowo.net.", "Warunki mogą być aktualizowane. Aktualna wersja jest publikowana na tej stronie wraz z datą aktualizacji."] },
];
---
<Layout title="Warunki korzystania — Paczkowo"><LegalDocument title="Warunki korzystania" lead="Zasady korzystania ze strony i aplikacji Paczkowo." updated="22 lipca 2026" sections={sections} /></Layout>
