---
import Layout from "../layouts/Layout.astro";

const plans = [
  { name: "Start", price: "0 zł", note: "Na początek", items: ["1 konto sprzedażowe", "Podstawowa obsługa zamówień", "Etykiety InPost"], href: "/pobierz", action: "Pobierz aplikację" },
  { name: "Pro", price: "79 zł", note: "miesięcznie", items: ["Do 3 kont sprzedażowych", "Magazyn i synchronizacja", "Nadania zbiorcze", "Wsparcie priorytetowe"], href: "/pobierz", action: "Wybierz Pro", featured: true },
  { name: "Biznes", price: "Indywidualnie", note: "dla zespołów", items: ["Więcej kont i użytkowników", "Indywidualny proces wdrożenia", "Rozszerzone wsparcie"], href: "mailto:kontakt@paczkowo.net", action: "Porozmawiajmy" },
];
---

<Layout title="Cennik Paczkowo" description="Wybierz plan Paczkowo dopasowany do skali sprzedaży.">
  <main>
    <section class="border-b border-white/10"><div class="mx-auto max-w-7xl px-4 py-16 text-center sm:px-6 lg:px-8 lg:py-24"><p class="eyebrow">Cennik</p><h1 class="mt-5 text-5xl font-bold text-white sm:text-6xl">Proste plany dla realnej skali pracy.</h1><p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-slate-300">Zacznij od aplikacji Windows. Wybierz zakres, który odpowiada liczbie kont i sposobowi pracy Twojego zespołu.</p></div></section>
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24"><div class="grid gap-px border border-white/10 bg-white/10 lg:grid-cols-3">{plans.map((plan) => <article class:list={["flex min-h-[440px] flex-col bg-[#101019] p-8", plan.featured ? "bg-brand-600" : ""]}><p class:list={["text-sm font-semibold", plan.featured ? "text-brand-100" : "text-brand-300"]}>{plan.name}</p><h2 class="mt-7 text-4xl font-bold text-white">{plan.price}</h2><p class:list={["mt-2 text-sm", plan.featured ? "text-brand-100" : "text-slate-500"]}>{plan.note}</p><ul class="mt-8 space-y-4">{plan.items.map((item) => <li class:list={["flex gap-3 text-sm leading-6", plan.featured ? "text-white" : "text-slate-300"]}><span class="mt-2 h-1.5 w-1.5 shrink-0 bg-current"></span>{item}</li>)}</ul><a href={plan.href} class:list={["mt-auto inline-flex justify-center px-5 py-3 text-sm font-semibold transition", plan.featured ? "bg-white text-brand-800 hover:bg-brand-50" : "border border-white/15 text-white hover:border-white/35"]}>{plan.action}</a></article>)}</div><p class="mt-6 text-sm text-slate-500">Ceny i dostępne opcje mogą ulec zmianie przed pełnym startem usługi.</p></section>
  </main>
</Layout>
