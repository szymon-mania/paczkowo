---
import Layout from "../layouts/Layout.astro";

const coreFeatures = [
  {
    title: "Bez limitu kont",
    text: "Podpinaj konta sprzedażowe i kurierskie bez sztucznego dzielenia pracy na pakiety.",
  },
  {
    title: "KSeF bez limitu",
    text: "Wystawiaj faktury i obsługuj dokumenty zgodne z KSeF bez liczenia każdego wysłania.",
  },
  {
    title: "Magazyn w cenie",
    text: "Kontroluj stany, lokalizacje, rezerwacje i pracę na produktach w jednym widoku.",
  },
  {
    title: "Zwroty pod kontrolą",
    text: "Przyjmuj zgłoszenia, pilnuj statusów, refundacji i logistyki zwrotnej bez ręcznego chaosu.",
  },
  {
    title: "Nadawanie paczek",
    text: "Twórz przesyłki, etykiety i obsługuj wysyłkę bez skakania między panelami przewoźników.",
  },
  {
    title: "Integracje platform",
    text: "Łącz sprzedaż z marketplace'ów, obsługuj zamówienia i edytuj oferty z jednego miejsca.",
  },
];

const included = [
  "14 dni pełnego testu za darmo",
  "Po okresie próbnym aplikacja wymaga aktywnego planu",
  "Bez limitu kont integracji",
  "Bez limitu dokumentów KSeF",
  "Moduł magazynu, zwrotów, ofert, faktur i wysyłek",
  "Aktualizacje oraz rozwój integracji w cenie",
];
---

<Layout title="Cennik Paczkowo" description="Paczkowo Standard: 14 dni za darmo, potem 150 zł miesięcznie za pełny dostęp bez limitu kont, KSeF, magazyn, zwroty, wysyłki i integracje.">
  <main>
    <section class="border-b border-white/10">
      <div class="mx-auto grid max-w-7xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:px-8 lg:py-24">
        <div>
          <p class="eyebrow">Cennik</p>
          <h1 class="mt-5 max-w-3xl text-5xl font-bold leading-tight text-white sm:text-6xl">Jeden plan. Całe Paczkowo.</h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">
            Testujesz wszystko przez 14 dni za darmo. Po okresie próbnym wybierasz Paczkowo Standard i pracujesz dalej bez limitów kont, KSeF i kluczowych modułów.
          </p>
        </div>
        <article class="surface-line p-6 sm:p-8">
          <div class="flex flex-wrap items-center justify-between gap-4 border-b border-white/10 pb-6">
            <div>
              <p class="text-sm font-semibold text-brand-300">Paczkowo Standard</p>
              <h2 class="mt-3 text-5xl font-bold text-white">150 zł</h2>
              <p class="mt-2 text-sm text-slate-400">miesięcznie</p>
            </div>
            <span class="border border-brand-300/40 bg-brand-500/10 px-3 py-2 text-xs font-semibold uppercase tracking-[0.16em] text-brand-200">14 dni gratis</span>
          </div>
          <p class="mt-6 text-base leading-7 text-slate-300">
            Dla sprzedawców, którzy chcą obsługiwać zamówienia, wysyłki, magazyn, faktury KSeF, oferty i zwroty w jednym konkretnym narzędziu.
          </p>
          <ul class="mt-8 grid gap-3">
            {included.map((item) => (
              <li class="flex gap-3 text-sm leading-6 text-slate-200">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 bg-brand-300"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="/pobierz" class="inline-flex justify-center bg-brand-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-brand-500">Pobierz i testuj 14 dni</a>
            <a href="/kontakt" class="inline-flex justify-center border border-white/15 px-5 py-3 text-sm font-semibold text-white transition hover:border-white/35">Zapytaj o wdrożenie</a>
          </div>
        </article>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
      <div class="max-w-2xl">
        <p class="eyebrow">W cenie</p>
        <h2 class="mt-4 text-3xl font-bold text-white sm:text-4xl">Funkcje, za które nie dopłacasz osobnym planem.</h2>
      </div>
      <div class="mt-10 grid gap-px border border-white/10 bg-white/10 md:grid-cols-2 lg:grid-cols-3">
        {coreFeatures.map((feature) => (
          <article class="bg-[#101019] p-7">
            <h3 class="text-lg font-semibold text-white">{feature.title}</h3>
            <p class="mt-3 text-sm leading-7 text-slate-400">{feature.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="border-y border-white/10 bg-[#101019]">
      <div class="mx-auto grid max-w-7xl gap-8 px-4 py-14 sm:px-6 lg:grid-cols-[1fr_0.8fr] lg:items-center lg:px-8">
        <div>
          <p class="eyebrow">Prosto i uczciwie</p>
          <h2 class="mt-4 text-3xl font-bold text-white">Na razie bez dodatkowych planów chmurowych.</h2>
          <p class="mt-4 max-w-2xl text-sm leading-7 text-slate-400">
            Obecny cennik jest prosty: 14 dni testu, a potem Paczkowo Standard. Bez rozbijania podstawowych funkcji na droższe warianty.
          </p>
        </div>
        <div class="border border-white/10 bg-black/20 p-6">
          <p class="text-sm font-semibold text-white">Po 14 dniach</p>
          <p class="mt-3 text-sm leading-7 text-slate-400">
            Konto testowe wygasa, jeśli nie aktywujesz planu. Dzięki temu możesz sprawdzić aplikację bez ryzyka i bez ukrytych opłat.
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>
