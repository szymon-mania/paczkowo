---
import ContactForm from "../components/ContactForm";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Pomoc i kontakt - Paczkowo" description="Skontaktuj się z zespołem Paczkowo: pytania, pomoc techniczna, błędy i propozycje integracji.">
  <main>
    <section class="border-b border-white/10">
      <div class="mx-auto grid max-w-7xl gap-12 px-4 py-16 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:items-start lg:px-8 lg:py-24">
        <div>
          <p class="eyebrow">Pomoc</p>
          <h1 class="mt-5 text-5xl font-bold leading-tight text-white sm:text-6xl">Porozmawiajmy.</h1>
          <p class="mt-6 max-w-xl text-lg leading-8 text-slate-300">Zgłoś błąd, zadaj pytanie albo opowiedz, jakiej integracji potrzebujesz. Odpowiemy na adres podany w formularzu.</p>
          <div class="mt-10 border-l-2 border-brand-400 pl-5 text-sm leading-7 text-slate-400">Wolisz e-mail? Napisz na <a href="mailto:kontakt@paczkowo.net" class="font-medium text-brand-300 hover:text-white">kontakt@paczkowo.net</a>.</div>
        </div>
        <div class="border border-white/10 bg-[#12121d] p-6 sm:p-8">
          <ContactForm client:load />
        </div>
      </div>
    </section>
  </main>
</Layout>
