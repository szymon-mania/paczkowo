---
import Layout from "../layouts/Layout.astro";

const groups = [
  { title: "Zamówienia", items: ["Wspólna kolejka", "Filtry i wyszukiwarka", "Dane klienta i dostawy"] },
  { title: "Wysyłka", items: ["Etykiety z zamówienia", "Numery śledzenia", "Nadania zbiorcze"] },
  { title: "Magazyn", items: ["Stany i rezerwacje", "Alerty niskiego stanu", "Synchronizacja ofert"] },
];

const highlights = [
  { title: "Faktury zgodne z KSeF", text: "Wystawiaj dokumenty, pilnuj statusów i przygotuj sprzedaż na obowiązki KSeF bez kolejnego panelu do sprawdzania." },
  { title: "Edycja ofert bez chaosu", text: "Poprawiaj ceny, opisy, zdjęcia i stany tam, gdzie pracujesz nad zamówieniami. Mniej klikania, mniej pomyłek." },
  { title: "Zwroty pod kontrolą", text: "RMA, terminy refundacji i decyzje magazynu widzisz w jednym miejscu, zanim drobna sprawa zrobi się dużym kosztem." },
];
---

<Layout title="Funkcje Paczkowo" description="Funkcje Paczkowo do obsługi zamówień, wysyłki, magazynu, faktur KSeF, ofert i zwrotów.">
  <main>
    <section class="border-b border-white/10"><div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24"><p class="eyebrow">Funkcje</p><h1 class="mt-5 max-w-3xl text-5xl font-bold leading-tight text-white sm:text-6xl">Mniej paneli. Więcej zrobionej pracy.</h1><p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">Paczkowo skupia codzienną obsługę sprzedaży w jednym miejscu.</p><a href="/demo" class="mt-8 inline-flex bg-brand-500 px-5 py-3 text-sm font-semibold text-white hover:bg-brand-400">Sprawdź demo →</a></div></section>
    <section class="border-y border-white/10 bg-[#101019]"><div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24"><div class="grid gap-px border border-white/10 bg-white/10 lg:grid-cols-3">{groups.map((group) => <article class="bg-[#101019] p-7"><h2 class="text-2xl font-semibold text-white">{group.title}</h2><ul class="mt-7 space-y-5">{group.items.map((item) => <li class="flex gap-3 text-sm leading-6 text-slate-400"><span class="mt-2 h-1.5 w-1.5 shrink-0 bg-brand-400"></span>{item}</li>)}</ul></article>)}</div><div class="mt-10 grid gap-px border border-white/10 bg-white/10 lg:grid-cols-3">{highlights.map((item) => <article class="bg-[#101019] p-7"><p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-300">Szybciej domykasz dzień</p><h2 class="mt-3 text-2xl font-semibold text-white">{item.title}</h2><p class="mt-5 text-sm leading-7 text-slate-400">{item.text}</p></article>)}</div></div></section>
  </main>
</Layout>
