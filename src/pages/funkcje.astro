---
import Layout from "../layouts/Layout.astro";
import ProductPreview from "../components/ProductPreview.astro";

const groups = [
  { title: "Zamówienia", items: ["Wspólna kolejka zamówień z podziałem na konta i kanały", "Statusy, filtry i szybkie wyszukiwanie potrzebne przy pakowaniu", "Podgląd kupującego, płatności, dostawy i pozycji bez zmiany systemu"] },
  { title: "Wysyłka", items: ["Tworzenie przesyłek i etykiet z poziomu zamówienia", "Obsługa numerów śledzenia i aktualizacji statusu", "Praca seryjna, gdy do nadania jest więcej niż jedna paczka"] },
  { title: "Magazyn", items: ["Stany, rezerwacje i historia zmian produktów", "Alerty niskiego stanu oraz proste przyjęcia dostaw", "Synchronizacja dostępności z podłączonymi kanałami"] },
];
---

<Layout title="Funkcje Paczkowo" description="Poznaj funkcje Paczkowo do obsługi zamówień, wysyłki i magazynu.">
  <main>
    <section class="border-b border-white/10"><div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24"><p class="eyebrow">Funkcje</p><h1 class="mt-5 max-w-3xl text-5xl font-bold leading-tight text-white sm:text-6xl">Narzędzia, które skracają drogę od zamówienia do nadania.</h1><p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">Paczkowo porządkuje operacyjną pracę sklepu. Widzisz co wymaga uwagi, wykonujesz akcję i przechodzisz dalej.</p></div></section>
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:grid lg:grid-cols-[0.85fr_1.15fr] lg:gap-16 lg:px-8 lg:py-24"><div><p class="eyebrow">Widok aplikacji</p><h2 class="mt-4 text-3xl font-bold text-white">Jedna przestrzeń do działania.</h2><p class="mt-5 max-w-md text-sm leading-7 text-slate-400">Kolejka nie musi być kolejną listą do odhaczenia. Ma pomagać podjąć właściwą akcję w odpowiednim momencie.</p></div><div class="mt-10 lg:mt-0"><ProductPreview /></div></section>
    <section class="border-y border-white/10 bg-[#101019]"><div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24"><div class="grid gap-px border border-white/10 bg-white/10 lg:grid-cols-3">{groups.map((group) => <article class="bg-[#101019] p-7"><h2 class="text-2xl font-semibold text-white">{group.title}</h2><ul class="mt-7 space-y-5">{group.items.map((item) => <li class="flex gap-3 text-sm leading-6 text-slate-400"><span class="mt-2 h-1.5 w-1.5 shrink-0 bg-brand-400"></span>{item}</li>)}</ul></article>)}</div></div></section>
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8"><div class="flex flex-col justify-between gap-6 border border-white/10 bg-[#141420] p-8 md:flex-row md:items-center"><div><p class="eyebrow">Zacznij od Windows</p><h2 class="mt-3 text-2xl font-semibold text-white">Sprawdź Paczkowo w swoim codziennym procesie.</h2></div><a href="/pobierz" class="inline-flex justify-center bg-brand-500 px-5 py-3 text-sm font-semibold text-white hover:bg-brand-400">Pobierz aplikację</a></div></section>
  </main>
</Layout>
