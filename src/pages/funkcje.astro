---
import Layout from "../layouts/Layout.astro";

const modules = [
  {
    title: "Zamówienia",
    lead: "Jedna kolejka z Allegro, Erli i InPost Merchant.",
    items: ["Filtry i wyszukiwanie po kliencie, SKU i numerze", "Dane klienta, dostawy i pozycji zamówienia", "Pobieranie osobno dla każdego konta"],
  },
  {
    title: "Wysyłka",
    lead: "Etykieta z zamówienia, bez przepisywania adresu.",
    items: ["Nadania InPost ShipX z Twojej umowy", "Nadania przez Allegro i Erli", "Numery śledzenia i odbiór kuriera"],
  },
  {
    title: "Magazyn",
    lead: "Stan schodzi sam przy wysyłce — Ty uzupełniasz dostawy.",
    items: ["Import produktów z ofert wraz ze stanem", "Przyjęcia po SKU/EAN i inwentaryzacja", "Alerty niskiego stanu z własnym progiem"],
  },
  {
    title: "Faktury i KSeF",
    lead: "Dokument z zamówienia i wysyłka do KSeF.",
    items: ["FA(3), korekty i numeracja lokalna", "Statusy KSeF: w toku, przyjęta, odrzucona, offline", "VAT krajowy, B2B UE, OSS i eksport"],
  },
  {
    title: "Oferty",
    lead: "Ceny i stany bez wchodzenia w panele kanałów.",
    items: ["Edycja cen i stanów w podłączonych kanałach", "Opisy i zdjęcia ofert", "Pobieranie ofert z limitem na konto"],
  },
  {
    title: "Zwroty",
    lead: "RMA od zgłoszenia do refundacji.",
    items: ["Zwroty pobierane z kanałów sprzedaży", "Transport, inspekcja, decyzja, refundacja", "Terminy i kwoty refundacji pod kontrolą"],
  },
];
---

<Layout title="Funkcje Paczkowo" description="Zamówienia, wysyłka, magazyn, faktury KSeF, oferty i zwroty — sześć modułów Paczkowo w jednej aplikacji.">
  <main>
    <section class="border-b border-white/10">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
        <p class="eyebrow">Funkcje</p>
        <h1 class="mt-5 max-w-3xl text-5xl font-bold leading-tight text-white sm:text-6xl">Sześć modułów. Jedno okno.</h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">Zamówienia, wysyłka, magazyn, faktury KSeF, oferty i zwroty — bez przełączania się między panelami.</p>
        <a href="/demo" class="mt-8 inline-flex bg-brand-500 px-5 py-3 text-sm font-semibold text-white hover:bg-brand-400">Sprawdź demo →</a>
      </div>
    </section>

    <section class="bg-[#101019]">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
        <div class="border-t border-white/10">
          {modules.map((module, index) => (
            <div class="grid gap-6 border-b border-white/10 py-8 lg:grid-cols-[minmax(0,0.38fr)_minmax(0,0.62fr)] lg:gap-12 lg:py-10">
              <div class="flex gap-5">
                <span class="mt-1.5 text-sm font-semibold text-brand-300">0{index + 1}</span>
                <div>
                  <h2 class="text-2xl font-semibold text-white">{module.title}</h2>
                  <p class="mt-2 max-w-sm text-sm leading-6 text-slate-400">{module.lead}</p>
                </div>
              </div>
              <ul class="grid gap-3 sm:grid-cols-2 lg:mt-1.5">
                {module.items.map((item) => (
                  <li class="flex gap-3 text-sm leading-6 text-slate-300">
                    <span class="mt-2 h-1.5 w-1.5 shrink-0 bg-brand-400"></span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
