---
import AppShell from "../layouts/AppShell.astro";

const kpis = [
  { label: "Nowe zamówienia", value: "128", delta: "+12%", tone: "brand" },
  { label: "Do spakowania", value: "37", delta: "−4", tone: "amber" },
  { label: "Wysłane dziś", value: "94", delta: "+8%", tone: "emerald" },
  { label: "Przychód (dziś)", value: "8 420 zł", delta: "+18%", tone: "slate" },
];

const channels = [
  { name: "Allegro — Sklep Główny", orders: 64, status: "Połączone" },
  { name: "Allegro — Outlet", orders: 22, status: "Połączone" },
  { name: "Erli — Sklep Główny", orders: 31, status: "Połączone" },
  { name: "InPost ShipX", orders: 0, status: "Aktywne" },
];
---

<AppShell title="Pulpit — Paczkowo" active="dashboard">
  <div class="mx-auto max-w-6xl space-y-8">
    <div>
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
        Dzień dobry, Jan 👋
      </h2>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
        Podgląd dnia. To wersja demonstracyjna interfejsu — dane są przykładowe.
      </p>
    </div>

    <!-- KPI -->
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        kpis.map((kpi) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
            <p class="text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">
              {kpi.label}
            </p>
            <div class="mt-2 flex items-baseline gap-2">
              <span class="text-2xl font-bold text-slate-900 dark:text-white">
                {kpi.value}
              </span>
              <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400">
                {kpi.delta}
              </span>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Kanały sprzedaży -->
    <div
      class="rounded-2xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900"
    >
      <div class="border-b border-slate-200 px-6 py-4 dark:border-slate-800">
        <h3 class="text-base font-semibold text-slate-900 dark:text-white">
          Podłączone kanały
        </h3>
      </div>
      <ul class="divide-y divide-slate-200 dark:divide-slate-800">
        {
          channels.map((ch) => (
            <li class="flex items-center justify-between px-6 py-4">
              <div>
                <p class="text-sm font-medium text-slate-900 dark:text-white">
                  {ch.name}
                </p>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                  {ch.orders} aktywnych zamówień
                </p>
              </div>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" />
                {ch.status}
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div
      class="rounded-2xl border border-dashed border-slate-300 bg-white p-6 text-center text-sm text-slate-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400"
    >
      Pełny pulpit z wykresami i raportami dostępny będzie w aplikacji
      desktopowej.{" "}
      <a href="/orders" class="font-medium text-brand-600 dark:text-brand-400"
        >Przejdź do zamówień →</a
      >
    </div>
  </div>
</AppShell>
