---
import Layout from "../layouts/Layout.astro";
import ProductPreview from "../components/ProductPreview.astro";

const features = [
  { number: "01", title: "Jedna kolejka zamówień", text: "Allegro, Erli i własne procesy w jednym spokojnym widoku." },
  { number: "02", title: "Wysyłka bez przełączania kart", text: "Twórz etykiety, drukuj i przekazuj numery śledzenia bez ręcznego kopiowania." },
  { number: "03", title: "Magazyn pod kontrolą", text: "Pilnuj stanów, rezerwacji i dostępności ofert tam, gdzie faktycznie pracujesz." },
  { number: "04", title: "Wiele kont, jeden rytm pracy", text: "Oddziel konta sprzedażowe, ale nie dziel zespołu na kilka paneli." },
];

const workflow = [
  ["Połącz", "Dodaj konto Allegro, Erli i usługi kurierskie."],
  ["Obsłuż", "Sortuj zamówienia według tego, co wymaga działania teraz."],
  ["Nadaj", "Drukuj etykiety i zamykaj wysyłkę z jednego miejsca."],
];
---

<Layout title="Paczkowo — OMS dla sprzedaży internetowej" description="Paczkowo porządkuje zamówienia, wysyłki i magazyn sprzedawców Allegro oraz Erli.">
  <main>
    <section class="border-b border-white/10">
      <div class="mx-auto grid max-w-7xl gap-12 px-4 py-16 sm:px-6 lg:grid-cols-[0.88fr_1.12fr] lg:items-center lg:px-8 lg:py-24">
        <div>
          <p class="eyebrow">System OMS dla e-commerce</p>
          <h1 class="mt-5 max-w-xl text-5xl font-bold leading-[1.02] text-white sm:text-6xl">Sprzedaż bez chaosu w zakładkach.</h1>
          <p class="mt-6 max-w-xl text-lg leading-8 text-slate-300">Paczkowo łączy zamówienia, etykiety, wysyłki i stany magazynowe w aplikacji desktopowej stworzonej do codziennej pracy sprzedawcy.</p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a href="/pobierz" class="inline-flex items-center justify-center gap-2 bg-brand-500 px-5 py-3.5 text-sm font-semibold text-white transition hover:bg-brand-400">Pobierz dla Windows <span aria-hidden="true">↓</span></a>
            <a href="/funkcje" class="inline-flex items-center justify-center border border-white/15 px-5 py-3.5 text-sm font-semibold text-white transition hover:border-white/35 hover:bg-white/5">Zobacz funkcje</a>
          </div>
          <div class="mt-10 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm text-slate-400"><span>Obsługiwane integracje:</span><img src="/brand/allegro.png" alt="Allegro" class="h-5 w-auto object-contain" /><img src="/brand/erli.png" alt="Erli" class="h-5 w-auto object-contain" /><img src="/brand/inpost.png" alt="InPost" class="h-6 w-auto object-contain" /></div>
        </div>
        <ProductPreview />
      </div>
    </section>

    <section class="border-b border-white/10 bg-[#101019]">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <div class="max-w-2xl"><p class="eyebrow">Praca w swoim tempie</p><h2 class="mt-4 text-3xl font-bold text-white sm:text-4xl">Każdy etap wysyłki ma swoje miejsce.</h2></div>
        <div class="mt-12 grid border-y border-white/10 md:grid-cols-3">
          {workflow.map(([title, text], index) => <div class:list={["py-7 md:px-8", index > 0 ? "md:border-l md:border-white/10" : ""]}><span class="text-sm font-semibold text-brand-300">0{index + 1}</span><h3 class="mt-6 text-xl font-semibold text-white">{title}</h3><p class="mt-3 max-w-xs text-sm leading-6 text-slate-400">{text}</p></div>)}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
      <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end"><div><p class="eyebrow">Funkcje, które zostają z Tobą</p><h2 class="mt-4 text-3xl font-bold text-white sm:text-4xl">Mniej ręcznej pracy. Więcej kontroli.</h2></div><a href="/funkcje" class="text-sm font-semibold text-brand-300 transition hover:text-white">Pełna lista funkcji →</a></div>
      <div class="mt-12 grid gap-px border border-white/10 bg-white/10 md:grid-cols-2">
        {features.map((feature) => <article class="bg-[#0f0f18] p-7"><span class="text-sm font-semibold text-brand-300">{feature.number}</span><h3 class="mt-8 text-xl font-semibold text-white">{feature.title}</h3><p class="mt-3 max-w-sm text-sm leading-6 text-slate-400">{feature.text}</p></article>)}
      </div>
    </section>

    <section class="border-y border-white/10 bg-brand-600">
      <div class="mx-auto flex max-w-7xl flex-col gap-8 px-4 py-14 sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8"><div><p class="text-sm font-semibold text-brand-100">Paczkowo dla Windows</p><h2 class="mt-3 text-3xl font-bold text-white">Pobierz aplikację i zacznij porządkować sprzedaż.</h2></div><a href="/pobierz" class="inline-flex shrink-0 items-center justify-center bg-white px-5 py-3.5 text-sm font-semibold text-brand-800 transition hover:bg-brand-50">Pobierz najnowszą wersję</a></div>
    </section>
  </main>
</Layout>
