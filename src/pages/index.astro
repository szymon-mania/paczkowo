---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.tsx";

const steps = [
  {
    n: "1",
    title: "Połącz konta",
    desc: "Zaloguj się do Allegro i Erli oraz podłącz InPost. Obsłuż dowolną liczbę kont sprzedażowych w jednym oknie.",
  },
  {
    n: "2",
    title: "Zarządzaj zamówieniami",
    desc: "Zamówienia spływają automatycznie. Filtruj, pakuj i aktualizuj statusy — bez przeklikiwania się między panelami.",
  },
  {
    n: "3",
    title: "Drukuj etykiety i wysyłaj",
    desc: "Generuj etykiety InPost jednym kliknięciem, nadawaj paczki i odsyłaj numery śledzenia do kupujących.",
  },
];

const features = [
  {
    title: "Integracja Allegro i Erli",
    desc: "Synchronizacja zamówień, ofert i statusów przez oficjalne API. Wszystko aktualne w czasie rzeczywistym.",
    icon: "plug",
  },
  {
    title: "Automatyczne etykiety InPost",
    desc: "Tworzenie etykiet do paczkomatów i kurierów oraz nadania zbiorcze prosto z aplikacji.",
    icon: "label",
  },
  {
    title: "Magazyn i stany",
    desc: "Kontroluj stany magazynowe, aktualizuj dostępność ofert i unikaj sprzedaży produktów, których nie masz.",
    icon: "box",
  },
  {
    title: "Multi-konto",
    desc: "Obsługuj wiele kont Allegro i Erli równocześnie. Jeden pulpit, jeden proces pakowania.",
    icon: "users",
  },
  {
    title: "Aplikacja desktopowa (Tauri)",
    desc: "Lekka, szybka i bezpieczna aplikacja na Windows, macOS i Linux. Dane zostają na Twoim komputerze.",
    icon: "desktop",
  },
  {
    title: "Szybkie pakowanie",
    desc: "Skróty klawiszowe, skan kodów i widok kolejki zamówień przyspieszają codzienną wysyłkę.",
    icon: "bolt",
  },
];

const plans = [
  {
    name: "Start",
    price: "0 zł",
    period: "/ mies.",
    desc: "Dla początkujących sprzedawców testujących automatyzację.",
    features: [
      "1 konto Allegro lub Erli",
      "Do 50 zamówień / mies.",
      "Etykiety InPost",
      "Wsparcie e-mail",
    ],
    cta: "Zacznij za darmo",
    href: "/pobierz",
    highlight: false,
  },
  {
    name: "Pro",
    price: "79 zł",
    period: "/ mies.",
    desc: "Dla rosnących sklepów obsługujących wysyłki codziennie.",
    features: [
      "Do 3 kont sprzedażowych",
      "Bez limitu zamówień",
      "Etykiety i nadania zbiorcze",
      "Zarządzanie magazynem",
      "Wsparcie priorytetowe",
    ],
    cta: "Wybierz Pro",
    href: "/pobierz",
    highlight: true,
  },
  {
    name: "Biznes",
    price: "Indywidualnie",
    period: "",
    desc: "Dla dużych sprzedawców i zespołów z wieloma kontami.",
    features: [
      "Bez limitu kont",
      "Wielu użytkowników",
      "Dedykowany opiekun",
      "Indywidualne integracje",
    ],
    cta: "Skontaktuj się",
    href: "#kontakt",
    highlight: false,
  },
];

const faqs = [
  {
    q: "Czym jest Paczkowo?",
    a: "Paczkowo to desktopowy system OMS (Order Management System) dla sprzedawców internetowych. Łączy zamówienia z Allegro i Erli, automatyzuje generowanie etykiet InPost i pomaga zarządzać magazynem z wielu kont w jednym miejscu.",
  },
  {
    q: "Na jakich systemach działa aplikacja?",
    a: "Paczkowo to aplikacja zbudowana w technologii Tauri, dostępna na Windows, macOS i Linux. Jest lekka i nie wymaga przeglądarki.",
  },
  {
    q: "Czy moje dane są bezpieczne?",
    a: "Tak. Aplikacja działa lokalnie na Twoim komputerze, a komunikacja z Allegro, Erli i InPost odbywa się przez oficjalne, autoryzowane API. Nie przechowujemy Twoich haseł.",
  },
  {
    q: "Czy mogę podłączyć kilka kont Allegro?",
    a: "Tak. W planach Pro i Biznes możesz obsługiwać wiele kont Allegro oraz Erli równocześnie z poziomu jednego pulpitu.",
  },
  {
    q: "Jak działa integracja z Allegro?",
    a: "Paczkowo korzysta z oficjalnego Allegro REST API do synchronizacji zamówień, ofert i stanów magazynowych. Szczegóły opisaliśmy na stronie informacyjnej o integracji.",
  },
  {
    q: "Ile kosztuje Paczkowo?",
    a: "Udostępniamy darmowy plan Start oraz płatne plany Pro i Biznes. Przedstawiony cennik jest wstępny i może ulec zmianie przed oficjalnym startem.",
  },
];

const icons: Record<string, string> = {
  plug: "M14.25 6.75V3m-4.5 3.75V3M7.5 9h9m-9 0v3a4.5 4.5 0 0 0 9 0V9m-4.5 7.5V21",
  label:
    "M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.1 18.1 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3ZM6 6h.008v.008H6V6Z",
  box: "m21 7.5-9-5.25L3 7.5m18 0-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9",
  users:
    "M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z",
  desktop:
    "M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0V12a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 12V5.25",
  bolt: "m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z",
};
---

<Layout>
  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-brand-50 to-white dark:from-slate-900 dark:to-slate-950"
    >
    </div>
    <div
      class="pointer-events-none absolute -top-24 left-1/2 -z-10 h-72 w-[42rem] -translate-x-1/2 rounded-full bg-brand-400/20 blur-3xl dark:bg-brand-600/20"
    >
    </div>

    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <span
          class="inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-sm font-medium text-brand-700 dark:border-brand-900/60 dark:bg-brand-950/40 dark:text-brand-300"
        >
          <span class="h-2 w-2 rounded-full bg-brand-500"></span>
          Dla sprzedawców Allegro i Erli
        </span>

        <h1
          class="mt-6 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-6xl dark:text-white"
        >
          Wszystkie zamówienia i wysyłki
          <span class="text-gradient"> w jednej aplikacji</span>
        </h1>

        <p
          class="mx-auto mt-6 max-w-2xl text-lg text-slate-600 dark:text-slate-300"
        >
          Paczkowo łączy Twoje konta Allegro i Erli, automatycznie generuje
          etykiety InPost i porządkuje magazyn. Pakuj szybciej, wysyłaj sprawniej
          — z jednego pulpitu na komputerze.
        </p>

        <div
          class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row"
        >
          <a
            href="/pobierz"
            class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-brand-600 px-6 py-3.5 text-base font-semibold text-white shadow-lg shadow-brand-600/20 transition hover:bg-brand-700 sm:w-auto"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="h-5 w-5"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5"
              ></path>
            </svg>
            Pobierz aplikację
          </a>
          <a
            href="#jak-to-dziala"
            class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-6 py-3.5 text-base font-semibold text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800 sm:w-auto"
          >
            Zobacz, jak to działa
          </a>
        </div>

        <p class="mt-4 text-sm text-slate-500 dark:text-slate-400">
          Windows · macOS · Linux — bez kart kredytowych na start.
        </p>
      </div>

      <!-- Podgląd „aplikacji" -->
      <div class="mx-auto mt-16 max-w-5xl">
        <div
          class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl shadow-slate-900/10 dark:border-slate-800 dark:bg-slate-900"
        >
          <div
            class="flex items-center gap-2 border-b border-slate-200 bg-slate-50 px-4 py-3 dark:border-slate-800 dark:bg-slate-950/60"
          >
            <span class="h-3 w-3 rounded-full bg-red-400"></span>
            <span class="h-3 w-3 rounded-full bg-amber-400"></span>
            <span class="h-3 w-3 rounded-full bg-emerald-400"></span>
            <span class="ml-3 text-xs text-slate-400">Paczkowo — Zamówienia</span>
          </div>
          <div class="grid gap-px bg-slate-200 sm:grid-cols-4 dark:bg-slate-800">
            {
              [
                { label: "Nowe zamówienia", value: "128", tone: "brand" },
                { label: "Do spakowania", value: "37", tone: "amber" },
                { label: "Wysłane dziś", value: "94", tone: "emerald" },
                { label: "Konta podłączone", value: "5", tone: "slate" },
              ].map((kpi) => (
                <div class="bg-white p-5 dark:bg-slate-900">
                  <p class="text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">
                    {kpi.label}
                  </p>
                  <p class="mt-1 text-2xl font-bold text-slate-900 dark:text-white">
                    {kpi.value}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- JAK TO DZIAŁA -->
  <section id="jak-to-dziala" class="py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2
          class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white"
        >
          Jak to działa
        </h2>
        <p class="mt-4 text-lg text-slate-600 dark:text-slate-300">
          Od podłączenia konta do nadanej paczki w trzech krokach.
        </p>
      </div>

      <div class="mt-16 grid gap-8 md:grid-cols-3">
        {
          steps.map((step) => (
            <div class="relative rounded-2xl border border-slate-200 bg-white p-8 dark:border-slate-800 dark:bg-slate-900">
              <span class="grid h-12 w-12 place-items-center rounded-xl bg-brand-600 text-lg font-bold text-white">
                {step.n}
              </span>
              <h3 class="mt-5 text-xl font-semibold text-slate-900 dark:text-white">
                {step.title}
              </h3>
              <p class="mt-2 text-slate-600 dark:text-slate-300">{step.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FUNKCJE -->
  <section
    id="funkcje"
    class="border-y border-slate-200 bg-slate-50 py-20 sm:py-24 dark:border-slate-800 dark:bg-slate-900/40"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2
          class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white"
        >
          Wszystko, czego potrzebujesz do wysyłki
        </h2>
        <p class="mt-4 text-lg text-slate-600 dark:text-slate-300">
          Jedno narzędzie zamiast pięciu otwartych zakładek.
        </p>
      </div>

      <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          features.map((f) => (
            <div class="rounded-2xl border border-slate-200 bg-white p-6 transition hover:shadow-lg hover:shadow-slate-900/5 dark:border-slate-800 dark:bg-slate-900">
              <span class="grid h-11 w-11 place-items-center rounded-xl bg-brand-50 text-brand-600 dark:bg-brand-950/50 dark:text-brand-400">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  class="h-6 w-6"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d={icons[f.icon]}
                  />
                </svg>
              </span>
              <h3 class="mt-4 text-lg font-semibold text-slate-900 dark:text-white">
                {f.title}
              </h3>
              <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
                {f.desc}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CENNIK -->
  <section id="cennik" class="py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2
          class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white"
        >
          Prosty cennik
        </h2>
        <p class="mt-4 text-lg text-slate-600 dark:text-slate-300">
          Wybierz plan dopasowany do skali sprzedaży. Ceny wstępne — finalny
          cennik ogłosimy przy starcie.
        </p>
      </div>

      <div class="mt-16 grid gap-8 lg:grid-cols-3">
        {
          plans.map((plan) => (
            <div
              class={`relative flex flex-col rounded-2xl border p-8 ${
                plan.highlight
                  ? "border-brand-600 bg-white shadow-xl shadow-brand-600/10 dark:bg-slate-900"
                  : "border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900"
              }`}
            >
              {plan.highlight && (
                <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-brand-600 px-3 py-1 text-xs font-semibold text-white">
                  Najpopularniejszy
                </span>
              )}
              <h3 class="text-lg font-semibold text-slate-900 dark:text-white">
                {plan.name}
              </h3>
              <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
                {plan.desc}
              </p>
              <p class="mt-6 flex items-baseline gap-1">
                <span class="text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
                  {plan.price}
                </span>
                <span class="text-sm text-slate-500 dark:text-slate-400">
                  {plan.period}
                </span>
              </p>
              <ul class="mt-6 space-y-3">
                {plan.features.map((feat) => (
                  <li class="flex items-start gap-2.5 text-sm text-slate-600 dark:text-slate-300">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.2"
                      class="mt-0.5 h-4 w-4 shrink-0 text-brand-600 dark:text-brand-400"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="m4.5 12.75 6 6 9-13.5"
                      />
                    </svg>
                    {feat}
                  </li>
                ))}
              </ul>
              <a
                href={plan.href}
                class={`mt-8 inline-flex items-center justify-center rounded-lg px-5 py-3 text-sm font-semibold transition ${
                  plan.highlight
                    ? "bg-brand-600 text-white hover:bg-brand-700"
                    : "border border-slate-300 text-slate-800 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-100 dark:hover:bg-slate-800"
                }`}
              >
                {plan.cta}
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- KONTAKT -->
  <section
    id="kontakt"
    class="border-y border-slate-200 bg-slate-50 py-20 sm:py-24 dark:border-slate-800 dark:bg-slate-900/40"
  >
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2
            class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white"
          >
            Masz pytanie przed instalacją?
          </h2>
          <p class="mt-4 text-lg text-slate-600 dark:text-slate-300">
            Napisz, na ilu kontach sprzedajesz i co chcesz usprawnić. Pomożemy
            ustawić Paczkowo pod Twój sposób pracy.
          </p>
          <ul class="mt-6 space-y-3 text-sm text-slate-600 dark:text-slate-300">
            {
              [
                "Pomoc przy pierwszym uruchomieniu",
                "Pytania o Allegro, Erli i InPost",
                "Informacje o nowych integracjach",
              ].map((item) => (
                <li class="flex items-center gap-2.5">
                  <span class="grid h-5 w-5 place-items-center rounded-full bg-brand-100 text-brand-700 dark:bg-brand-950/60 dark:text-brand-300">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="h-3.5 w-3.5"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M19.916 4.626a.75.75 0 0 1 .208 1.04l-9 13.5a.75.75 0 0 1-1.154.114l-6-6a.75.75 0 0 1 1.06-1.06l5.353 5.353 8.493-12.74a.75.75 0 0 1 1.04-.207Z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </span>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>

        <div
          class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8 dark:border-slate-800 dark:bg-slate-900"
        >
          <ContactForm client:visible />
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="py-20 sm:py-24">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h2
          class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white"
        >
          Najczęstsze pytania
        </h2>
        <p class="mt-4 text-lg text-slate-600 dark:text-slate-300">
          Nie znalazłeś odpowiedzi?{" "}
          <a
            href="mailto:kontakt@paczkowo.net"
            class="font-medium text-brand-600 hover:underline dark:text-brand-400"
            >Napisz do nas</a
          >.
        </p>
      </div>

      <div class="mt-12 space-y-4">
        {
          faqs.map((faq) => (
            <details class="group rounded-xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
              <summary class="flex cursor-pointer items-center justify-between gap-4 text-left text-base font-semibold text-slate-900 marker:content-none dark:text-white">
                {faq.q}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="h-5 w-5 shrink-0 text-slate-400 transition group-open:rotate-180"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="m19.5 8.25-7.5 7.5-7.5-7.5"
                  />
                </svg>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
                {faq.a}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
