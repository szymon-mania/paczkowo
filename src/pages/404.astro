---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404. Nie znaleziono strony | Paczkowo">
  <main class="mx-auto flex max-w-xl flex-col items-center px-4 py-28 text-center">
    <p class="text-7xl font-extrabold text-brand-600 dark:text-brand-400">404</p>
    <h1 class="mt-4 text-2xl font-bold text-slate-900 dark:text-white">
      Tej strony nie ma
    </h1>
    <p class="mt-2 text-slate-600 dark:text-slate-400">
      Strona, której szukasz, mogła zostać przeniesiona lub nie istnieje.
    </p>
    <a
      href="/"
      class="mt-8 rounded-lg bg-brand-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700"
    >
      Wróć na stronę główną
    </a>
  </main>
</Layout>
