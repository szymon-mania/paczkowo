---
import Layout from "../layouts/Layout.astro";
import LegalDocument from "../components/LegalDocument.astro";

const sections = [
  { title: "Administrator danych", paragraphs: ["Administratorem danych jest podmiot prowadzący markę Paczkowo. Przed publikacją produkcyjną należy wpisać pełną nazwę przedsiębiorcy, adres, NIP oraz dane kontaktowe.", "W sprawach prywatności można kontaktować się pod adresem kontakt@paczkowo.net."] },
  { title: "Zakres danych", paragraphs: ["W zależności od użytej funkcji możemy przetwarzać dane konta użytkownika, dane kontaktowe przesłane przez formularz oraz dane potrzebne do działania połączonych integracji.", "Dane z integracji są wykorzystywane wyłącznie do realizacji funkcji wybranych przez użytkownika, takich jak obsługa zamówień, wysyłka lub magazyn."] },
  { title: "Cele i podstawa przetwarzania", paragraphs: ["Dane przetwarzamy w celu świadczenia usługi, obsługi kontaktu, bezpieczeństwa konta oraz realizacji obowiązków prawnych.", "Podstawą przetwarzania jest wykonanie umowy, uzasadniony interes administratora albo zgoda użytkownika, zależnie od charakteru danej czynności."] },
  { title: "Odbiorcy i bezpieczeństwo", paragraphs: ["Dane mogą być przekazywane dostawcom infrastruktury i usług niezbędnych do działania Paczkowo, a także dostawcom integracji wskazanym przez użytkownika.", "Stosujemy środki techniczne i organizacyjne adekwatne do charakteru przetwarzanych danych. Dostęp do integracji wymaga autoryzacji użytkownika."] },
  { title: "Prawa użytkownika", paragraphs: ["Użytkownik może żądać dostępu do danych, ich sprostowania, usunięcia, ograniczenia przetwarzania, przeniesienia lub wnieść sprzeciw, jeżeli przepisy przewidują takie uprawnienie.", "Użytkownik ma również prawo złożyć skargę do właściwego organu nadzorczego."] },
];
---
<Layout title="Polityka prywatności — Paczkowo"><LegalDocument title="Polityka prywatności" lead="Informacje o tym, jakie dane są przetwarzane przy korzystaniu z Paczkowo." updated="22 lipca 2026" sections={sections} /></Layout>
