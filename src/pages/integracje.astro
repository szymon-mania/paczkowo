---
import Layout from "../layouts/Layout.astro";

const integrations = [
  { image: "/brand/allegro.png", name: "Allegro", type: "Marketplace", text: "Zamówienia, oferty i wysyłka." },
  { image: "/brand/erli.png", name: "Erli", type: "Marketplace", text: "Sprzedaż bez zmiany panelu." },
  { image: "/brand/inpost.png", name: "InPost", type: "Wysyłka", text: "Przesyłki i etykiety." },
];
---

<Layout title="Integracje Paczkowo" description="Integracje Paczkowo z Allegro, Erli i InPost.">
  <main>
    <section class="border-b border-white/10"><div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24"><p class="eyebrow">Integracje</p><h1 class="mt-5 max-w-3xl text-5xl font-bold leading-tight text-white sm:text-6xl">Twoje kanały. Jeden widok.</h1><p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">Łącz konta, obsługuj zamówienia, nadaj paczki.</p></div></section>
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24"><div class="grid gap-px border border-white/10 bg-white/10 lg:grid-cols-3">{integrations.map((integration) => <article class="bg-[#101019] p-8"><div class="flex h-14 items-center"><img src={integration.image} alt={integration.name} class="max-h-10 max-w-32 object-contain object-left" /></div><p class="mt-10 text-xs font-semibold uppercase tracking-[0.16em] text-brand-300">{integration.type}</p><h2 class="mt-3 text-2xl font-semibold text-white">{integration.name}</h2><p class="mt-4 text-sm leading-7 text-slate-400">{integration.text}</p></article>)}</div></section>
    <section class="border-y border-white/10 bg-[#101019]"><div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-16 sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8"><div><p class="eyebrow">Kontrola po Twojej stronie</p><h2 class="mt-4 text-3xl font-bold text-white">Łączysz tylko wybrane konta.</h2></div><a href="/allegro-api-info" class="inline-flex shrink-0 border border-white/15 px-5 py-3 text-sm font-semibold text-white hover:border-brand-300 hover:text-brand-200">Allegro API →</a></div></section>
  </main>
</Layout>
