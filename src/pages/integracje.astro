---
import Layout from "../layouts/Layout.astro";

const integrations = [
  { image: "/brand/allegro.png", name: "Allegro" },
  { image: "/brand/erli.png", name: "Erli" },
  { image: "/brand/inpost.png", name: "InPost" },
  { image: "/logos/inpost_merchant.png", name: "InPost Merchant" },
  { image: "/logos/inpost.png", name: "InPost ShipX" },
];
---

<Layout title="Integracje Paczkowo" description="Integracje Paczkowo z Allegro, Erli i InPost. Kolejne integracje w przygotowaniu.">
  <main>
    <section class="border-b border-white/10">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
        <p class="eyebrow">Integracje</p>
        <h1 class="mt-5 max-w-3xl text-5xl font-bold leading-tight text-white sm:text-6xl">Twoje kanały. Jeden widok.</h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">Łącz konta, obsługuj zamówienia, edytuj oferty i nadawaj paczki.</p>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
      <div class="grid gap-px border border-white/10 bg-white/10 md:grid-cols-2 lg:grid-cols-3">
        {integrations.map((integration) => (
          <article class="flex min-h-48 flex-col items-center justify-center bg-[#101019] p-8 text-center">
            <img src={integration.image} alt={integration.name} class="max-h-14 max-w-44 object-contain" />
            <h2 class="mt-7 text-xl font-semibold text-white">{integration.name}</h2>
          </article>
        ))}
        <a href="/kontakt#formularz" class="group flex min-h-48 flex-col items-center justify-center bg-[#101019] p-8 text-center transition hover:bg-[#151522]">
          <span class="border border-white/15 px-4 py-2 text-xs font-semibold uppercase tracking-[0.16em] text-slate-300 transition group-hover:border-brand-300 group-hover:text-brand-200">Zgłoś integrację</span>
          <h2 class="mt-7 text-xl font-semibold text-white">Brakuje platformy?</h2>
        </a>
      </div>
    </section>

    <section class="border-y border-white/10 bg-[#101019]">
      <div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-16 sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8">
        <div>
          <p class="eyebrow">Kontrola po Twojej stronie</p>
          <h2 class="mt-4 text-3xl font-bold text-white">Łączysz tylko wybrane konta.</h2>
        </div>
        <a href="/allegro-api-info" class="inline-flex shrink-0 border border-white/15 px-5 py-3 text-sm font-semibold text-white hover:border-brand-300 hover:text-brand-200">Allegro API →</a>
      </div>
    </section>
  </main>
</Layout>