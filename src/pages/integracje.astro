---
import Layout from "../layouts/Layout.astro";

const groups = [
  {
    label: "Sprzedaż i zamówienia",
    items: [
      { name: "Allegro", image: "/brand/allegro.png", desc: "Zamówienia, oferty i stany magazynowe", auth: "Logowanie Allegro" },
      { name: "Erli", image: "/brand/erli.png", desc: "Zamówienia, oferty i nadania", auth: "Klucz API" },
      { name: "InPost Merchant", image: "/logos/inpost_merchant.png", desc: "Zamówienia i oferty z InPost", auth: "Logowanie InPost" },
    ],
  },
  {
    label: "Wysyłka",
    items: [
      { name: "InPost ShipX", image: "/logos/inpost.png", desc: "Etykiety, nadania zbiorcze i odbiór kuriera", auth: "Token ShipX" },
    ],
  },
  {
    label: "Faktury",
    items: [
      { name: "Krajowy System e-Faktur", mark: "KSeF", desc: "Wysyłka faktur FA(3) i statusy z KSeF", auth: "NIP + certyfikat" },
    ],
  },
];
---

<Layout title="Integracje Paczkowo" description="Paczkowo łączy się z Allegro, Erli, InPost Merchant, InPost ShipX i KSeF.">
  <main>
    <section class="border-b border-white/10">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
        <p class="eyebrow">Integracje</p>
        <h1 class="mt-5 max-w-3xl text-5xl font-bold leading-tight text-white sm:text-6xl">Podłącz swoje konta.</h1>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <div class="grid gap-12">
        {groups.map((group) => (
          <div class="grid gap-6 lg:grid-cols-[minmax(0,0.28fr)_minmax(0,0.72fr)] lg:gap-10">
            <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-300">{group.label}</h2>
            <div class="border-t border-white/10">
              {group.items.map((item) => (
                <div class="flex flex-wrap items-center gap-x-6 gap-y-3 border-b border-white/10 py-6">
                  <div class="flex h-12 w-14 shrink-0 items-center justify-center">
                    {item.image
                      ? <img src={item.image} alt={item.name} class="max-h-10 max-w-14 object-contain" />
                      : <span class="border border-white/15 px-2.5 py-1.5 text-xs font-semibold tracking-[0.1em] text-slate-300">{item.mark}</span>}
                  </div>
                  <div class="min-w-0 flex-1">
                    <h3 class="text-lg font-semibold text-white">{item.name}</h3>
                    <p class="mt-1 text-sm leading-6 text-slate-400">{item.desc}</p>
                  </div>
                  <span class="text-xs font-medium uppercase tracking-[0.12em] text-slate-500">{item.auth}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="border-y border-white/10 bg-[#101019]">
      <div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-14 sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8">
        <div>
          <p class="eyebrow">Wkrótce więcej</p>
          <h2 class="mt-4 text-3xl font-bold text-white">Kolejne integracje w budowie.</h2>
          <p class="mt-3 max-w-xl text-sm leading-7 text-slate-400">Napisz, z czego korzystasz. To ustala kolejność.</p>
        </div>
        <a href="/kontakt?kategoria=integracja#formularz" class="inline-flex shrink-0 items-center justify-center bg-brand-500 px-5 py-3.5 text-sm font-semibold text-white transition hover:bg-brand-400">Potrzebuję integracji →</a>
      </div>
    </section>
  </main>
</Layout>
