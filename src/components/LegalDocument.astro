---
/** Blok treści: akapit (HTML dopuszczalny, treść pochodzi z repozytorium) albo lista punktów. */
export type LegalBlock = string | string[];
export interface LegalSection {
  title: string;
  blocks: LegalBlock[];
}

interface Props {
  title: string;
  lead: string;
  updated: string;
  sections: LegalSection[];
}
const { title, lead, updated, sections } = Astro.props;
const anchor = (index: number) => `sekcja-${index + 1}`;
---

<main class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
  <p class="eyebrow">Dokumenty</p>
  <h1 class="mt-5 text-4xl font-bold text-white sm:text-5xl">{title}</h1>
  <p class="mt-6 text-lg leading-8 text-slate-300">{lead}</p>
  <p class="mt-4 text-sm text-slate-500">Ostatnia aktualizacja: {updated}</p>

  <nav aria-label="Spis treści" class="surface-line mt-10 p-5 sm:p-6">
    <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-300">Spis treści</h2>
    <ol class="mt-4 grid gap-2 sm:grid-cols-2">
      {sections.map((section, index) => (
        <li class="text-sm leading-6 text-slate-400">
          <a href={`#${anchor(index)}`} class="transition hover:text-brand-300">{index + 1}. {section.title}</a>
        </li>
      ))}
    </ol>
  </nav>

  <article class="mt-12 space-y-10">
    {sections.map((section, index) => (
      <section id={anchor(index)} class="scroll-mt-24">
        <h2 class="text-xl font-semibold text-white">{index + 1}. {section.title}</h2>
        <div class="mt-4 space-y-4 text-sm leading-7 text-slate-300">
          {section.blocks.map((block) => Array.isArray(block)
            ? <ul class="space-y-2">{block.map((item) => (
                <li class="flex gap-3">
                  <span class="mt-3 h-1 w-1 shrink-0 bg-brand-400"></span>
                  <span set:html={item} />
                </li>
              ))}</ul>
            : <p set:html={block} />)}
        </div>
      </section>
    ))}
  </article>
</main>
