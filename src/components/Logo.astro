---
interface Props { class?: string; }
const { class: className = "" } = Astro.props;
---

<a href="/" class={`inline-flex items-center gap-2.5 font-semibold tracking-tight ${className}`} aria-label="Paczkowo, strona główna">
  <img src="/brand/paczkowo-logo.png" alt="" class="h-9 w-9" width="36" height="36" />
  <span class="text-lg text-white">Paczkowo</span>
</a>
