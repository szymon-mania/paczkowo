---
const rows = [
  { id: "#A-4281", buyer: "Kamil Nowak", channel: "Allegro", state: "Do spakowania", tone: "violet" },
  { id: "#E-9914", buyer: "Anna Wrona", channel: "Erli", state: "Etykieta gotowa", tone: "green" },
  { id: "#A-4277", buyer: "Dom i Ogród", channel: "Allegro", state: "Wysłane", tone: "slate" },
];
---

<div class="overflow-hidden border border-white/10 bg-[#12121d] shadow-2xl shadow-black/30">
  <div class="flex h-11 items-center justify-between border-b border-white/10 bg-[#171724] px-4">
    <div class="flex items-center gap-2"><span class="h-2.5 w-2.5 bg-[#ff4b5c]"></span><span class="h-2.5 w-2.5 bg-[#f4b942]"></span><span class="h-2.5 w-2.5 bg-[#42d392]"></span></div>
    <span class="text-xs font-medium text-slate-500">Paczkowo · Zamówienia</span>
    <span class="h-5 w-14 border border-white/10"></span>
  </div>
  <div class="grid min-h-[390px] grid-cols-[164px_1fr]">
    <aside class="hidden border-r border-white/10 bg-[#101019] p-3 sm:block">
      <div class="flex items-center gap-2 px-2 py-2"><img src="/brand/paczkowo-logo.png" alt="" class="h-6 w-6" /><span class="text-xs font-semibold text-white">Pulpit</span></div>
      <div class="mt-5 space-y-1 text-xs"><div class="bg-brand-500/15 px-3 py-2 font-medium text-brand-200">Zamówienia <span class="float-right">37</span></div><div class="px-3 py-2 text-slate-500">Wysyłki</div><div class="px-3 py-2 text-slate-500">Magazyn</div><div class="px-3 py-2 text-slate-500">Oferty</div></div>
    </aside>
    <div class="min-w-0 p-4 sm:p-5">
      <div class="flex flex-wrap items-start justify-between gap-3"><div><p class="text-xs text-slate-500">Dzisiaj, 10:42</p><h2 class="mt-1 text-lg font-semibold text-white">Zamówienia do obsługi</h2></div><button type="button" class="bg-brand-500 px-3 py-2 text-xs font-semibold text-white">Drukuj etykiety</button></div>
      <div class="mt-5 grid grid-cols-3 gap-2"><div class="border border-white/10 bg-white/[0.03] p-3"><p class="text-[10px] uppercase tracking-wide text-slate-500">Nowe</p><p class="mt-1 text-xl font-semibold text-white">18</p></div><div class="border border-white/10 bg-white/[0.03] p-3"><p class="text-[10px] uppercase tracking-wide text-slate-500">Pakowanie</p><p class="mt-1 text-xl font-semibold text-white">37</p></div><div class="border border-white/10 bg-white/[0.03] p-3"><p class="text-[10px] uppercase tracking-wide text-slate-500">Wysłane</p><p class="mt-1 text-xl font-semibold text-white">94</p></div></div>
      <div class="mt-4 overflow-hidden border border-white/10"><div class="grid grid-cols-[1.1fr_1fr_auto] gap-3 border-b border-white/10 bg-white/[0.03] px-3 py-2 text-[10px] font-semibold uppercase tracking-wide text-slate-500"><span>Zamówienie</span><span>Kanał</span><span>Status</span></div>{rows.map((row) => <div class="grid grid-cols-[1.1fr_1fr_auto] gap-3 border-b border-white/5 px-3 py-3 text-xs last:border-0"><div><strong class="block text-slate-100">{row.id}</strong><span class="text-slate-500">{row.buyer}</span></div><span class="self-center text-slate-400">{row.channel}</span><span class:list={["self-center whitespace-nowrap px-2 py-1 text-[10px] font-medium", row.tone === "green" ? "bg-emerald-400/10 text-emerald-300" : row.tone === "violet" ? "bg-brand-400/15 text-brand-200" : "bg-white/10 text-slate-400"]}>{row.state}</span></div>)}</div>
    </div>
  </div>
</div>
