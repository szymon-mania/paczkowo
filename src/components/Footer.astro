---
import Logo from "./Logo.astro";
const year = new Date().getFullYear();
const columns = [
  { title: "Produkt", links: [{ href: "/funkcje", label: "Funkcje" }, { href: "/integracje", label: "Integracje" }, { href: "/cennik", label: "Cennik" }, { href: "/pobierz", label: "Pobierz dla Windows" }] },
  { title: "Pomoc", links: [{ href: "/allegro-api-info", label: "Integracja z Allegro API" }, { href: "mailto:kontakt@paczkowo.net", label: "Kontakt" }] },
  { title: "Dokumenty", links: [{ href: "/warunki-korzystania", label: "Warunki korzystania" }, { href: "/polityka-prywatnosci", label: "Polityka prywatności" }] },
];
---

<footer class="border-t border-white/10 bg-[#09090f]">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-5">
      <div class="lg:col-span-2">
        <Logo />
        <p class="mt-4 max-w-sm text-sm leading-6 text-slate-400">Desktopowy system OMS dla sprzedawców, którzy chcą mieć zamówienia, wysyłki i magazyn w jednym miejscu.</p>
      </div>
      {columns.map((column) => <div><h2 class="text-sm font-semibold text-white">{column.title}</h2><ul class="mt-4 space-y-3">{column.links.map((link) => <li><a href={link.href} class="text-sm text-slate-400 transition hover:text-brand-300">{link.label}</a></li>)}</ul></div>)}
    </div>
    <div class="mt-10 flex flex-col gap-3 border-t border-white/10 pt-6 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Paczkowo. Wszelkie prawa zastrzeżone.</p>
      <a href="mailto:kontakt@paczkowo.net" class="transition hover:text-white">kontakt@paczkowo.net</a>
    </div>
  </div>
</footer>
