---
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import { company } from "../config/company";

interface Props {
  title?: string;
  description?: string;
  /** Pokaż globalny nagłówek i stopkę (domyślnie true). Wyłączane np. w panelu/logowaniu. */
  chrome?: boolean;
}

Astro.props satisfies Props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const title = "Paczkowo - wracamy z nową wersją";
const description =
  "Paczkowo jest chwilowo niedostępne, bo budujemy nową odsłonę produktu.";
---

<!doctype html>
<html lang="pl" class="scroll-smooth dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0b0b12" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pl_PL" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Ustawienie motywu przed renderem, aby uniknąć migotania (FOUC). -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem("theme");
          document.documentElement.classList.toggle("dark", stored !== "light");
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="site-shell min-h-screen">
    <main class="flex min-h-screen items-center px-4 py-12 sm:px-6 lg:px-8">
      <section class="mx-auto w-full max-w-4xl">
        <Logo class="justify-center" />

        <div class="mt-14 border-y border-white/10 py-12 text-center sm:py-16">
          <p class="eyebrow justify-center">Przerwa techniczna</p>
          <h1 class="mx-auto mt-6 max-w-3xl text-4xl font-bold leading-tight text-white sm:text-6xl">
            Paczkowo wznosi się na nowy poziom.
          </h1>
          <p class="mx-auto mt-6 max-w-2xl text-base leading-8 text-slate-300 sm:text-lg">
            Na krótko wyłączamy stronę, bo budujemy nową odsłonę produktu.
            Wracamy niedługo z wygodniejszą obsługą zamówień, wysyłek i magazynu.
          </p>

          <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <span class="border border-white/15 px-5 py-3 text-sm font-semibold text-white">
              Trwają prace
            </span>
            <a
              href={`mailto:${company.email}`}
              class="px-5 py-3 text-sm font-semibold text-brand-300 transition hover:text-white"
            >
              Kontakt: {company.email}
            </a>
          </div>
        </div>

        <p class="mt-8 text-center text-sm leading-6 text-slate-500">
          Dziękujemy za cierpliwość. Ta przerwa jest po to, żeby Paczkowo działało lepiej tam,
          gdzie liczy się codzienna praca sprzedawcy.
        </p>
      </section>
    </main>
  </body>
</html>
